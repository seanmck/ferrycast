# FerryCast crontab — the recommended deployment.
#
#   crontab -e   and paste, adjusting paths.
#
# Phase 1 of the PRD is just the capture line: ship that first and data accrues while
# everything else is built.

FERRYCAST_CONFIG=/srv/ferrycast/config/ferrycast.toml
ANTHROPIC_API_KEY=sk-ant-...
PATH=/srv/ferrycast/.venv/bin:/usr/local/bin:/usr/bin:/bin

# R1 + R2 — archive a frame from each camera and scrape deck space, every 15 minutes.
# Neither costs money. Capture is here because it is the one irreversible step: extraction
# can always be run later, but a frame not taken at 14:15 is gone for good. Keep the
# interval at 15 minutes or slower: be a polite scraper.
*/15 * * * *  ferrycast capture >> /var/log/ferrycast/capture.log 2>&1; ferrycast scrape >> /var/log/ferrycast/scrape.log 2>&1

# R4 — turn yesterday's readings into one record per sailing. Free: this runs on deck
# space, so every sailing gets a record whether or not any frame was ever analysed.
23 3 * * *    ferrycast aggregate --date yesterday >> /var/log/ferrycast/aggregate.log 2>&1

# Retention. Frames aged past `thin_unextracted_after_days` and still unread are thinned
# down to the ones an extraction would actually use, so the archive stays bounded (roughly
# 2.8 GB/year rather than 5.7) without losing the ability to analyse any sailing.
41 4 * * 0    ferrycast prune >> /var/log/ferrycast/prune.log 2>&1
47 4 * * 0    ferrycast health --window 7 --strict

# NOTHING ABOVE SPENDS MONEY. The vision model runs only when you ask:
#     ferrycast check --origin ERL --time 15:25          # ~$0.004, reads the camera now
#     ferrycast extract --essential --for-date 2026-07-04  # ~$0.09, analyse one past day
#
# ---------------------------------------------------------------------------------------
# OPTIONAL: analyse every day automatically (~$2.65/month).
#
# Deck space says when the vessel ran out of room, not how many vehicles were still queued
# outside the terminal — so it cannot tell a one-sailing wait from a three-sailing one.
# Only the cameras can. Uncomment to build that finer record continuously:
#
# 17 2 * * *   ferrycast extract --essential --for-date yesterday >> /var/log/ferrycast/extract.log 2>&1
# ---------------------------------------------------------------------------------------

# Retention plus the weekly digest. `health --strict` exits non-zero when something is
# wrong, so cron's MAILTO only reaches you when there is a problem to read about.
41 4 * * 0    ferrycast prune >> /var/log/ferrycast/prune.log 2>&1
47 4 * * 0    ferrycast health --window 7 --strict

# After changing the prompt (bump `prompt_version` in the config), re-extract the backlog
# by hand rather than on a schedule:
#   ferrycast extract --limit 500 && ferrycast aggregate --all
