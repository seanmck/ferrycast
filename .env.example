# Copy to .env and source it, or set these in your crontab / systemd unit.

# Required for `ferrycast extract` (R3). Capture and scraping work without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point at a config file outside the default config/ferrycast.toml
# FERRYCAST_CONFIG=/srv/ferrycast/config/ferrycast.toml
